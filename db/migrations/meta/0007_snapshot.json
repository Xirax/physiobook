      "checkConstraints": {
        "calendar_blocks_period_bounded": {
          "name": "calendar_blocks_period_bounded",
          "value": "NOT isempty(\"calendar_blocks\".\"period\")\n        AND NOT lower_inf(\"calendar_blocks\".\"period\") AND NOT upper_inf(\"calendar_blocks\".\"period\")\n        AND lower_inc(\"calendar_blocks\".\"period\") AND NOT upper_inc(\"calendar_blocks\".\"period\")"
        },
        "calendar_blocks_appointment_on_the_hour": {
          "name": "calendar_blocks_appointment_on_the_hour",
          "value": "\"calendar_blocks\".\"kind\" <> 'appointment' OR (\n        date_trunc('hour', lower(\"calendar_blocks\".\"period\"), 'UTC') = lower(\"calendar_blocks\".\"period\")\n        AND upper(\"calendar_blocks\".\"period\") = lower(\"calendar_blocks\".\"period\") + interval '1 hour'\n      )"
        }
