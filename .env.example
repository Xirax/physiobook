# PhysioBook — example environment
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is not.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# This file documents EVERY variable the app needs. It grows as tickets
# introduce variables:
#   0.2  docker compose  -> POSTGRES_*, DATABASE_URL, MAILPIT_*, service ports
#   E1.2 auth            -> JWT_SECRET, JWT_ACCESS_TTL_SECONDS
#   E1.3 login/sessions  -> REFRESH_TTL_SECONDS, AUTH_RATE_LIMIT_*
#   E1.6 refresh/logout  -> REFRESH_RATE_LIMIT_MAX (no refresh secret — see below)
#   4.1  pg-boss worker  -> WORKER_HEALTH_PORT
#   4.2  mail transport  -> MAIL_* (worker only)
#
# Rule (CLAUDE.md §5.8): no secrets in code. Every variable is validated at boot
# by `backend/src/config/env.ts` (Zod) and this file is updated in the same PR
# that adds it.
#
# The values below are local-development defaults and are safe to commit — they
# only ever reach a throwaway container. Production values come from the
# deployment environment, never from a file in the repo.

# Runtime mode: development | test | production
NODE_ENV=development

# --- Postgres -----------------------------------------------------------------
# Consumed by the `postgres` service (POSTGRES_* are the official image's own
# variables) and used by docker-compose.yml to build the backend's in-network
# connection string.
POSTGRES_USER=physiobook
POSTGRES_PASSWORD=physiobook
POSTGRES_DB=physiobook

# Host port the database is published on. Change it if 5432 is already taken by
# a local Postgres install; the in-container port is always 5432.
POSTGRES_PORT=5432

# Host-facing connection string: for tools you run on the host (drizzle-kit,
# psql, one-off scripts). It points at localhost:POSTGRES_PORT.
#
# The backend container does NOT use this — docker-compose.yml gives it a URL
# pointing at the `postgres` service on the compose network instead. Keep the
# credentials here in sync with POSTGRES_* above.
DATABASE_URL=postgres://physiobook:physiobook@localhost:5432/physiobook

# Password hash for the default admin (admin@physiobook.local) that the users
# data migration creates. Read ONLY on the first migrate of a database that has
# no admin yet — setting it later changes nothing.
#
# Left blank here on purpose. Blank means the migration falls back to a hash
# whose password is committed in db/migrations/0001_users_updated_at_and_admin.sql
# and is therefore public, which is fine for a throwaway local database and
# nowhere else. `pnpm db:migrate` warns every time it takes that path.
#
# Any real deployment sets this to a bcrypt/argon2 hash it generated itself.
ADMIN_PASSWORD_HASH=

# --- Auth ---------------------------------------------------------------------
# Signing key for access tokens (HS256). At least 32 characters — the server
# refuses to start below that, since a key shorter than SHA-256's own output is
# the weakest link in the signature.
#
# The value below is a development placeholder and is PUBLIC — it is committed
# in this file. It is long enough to boot, so `docker compose up` works from a
# fresh clone; it is also the exact string `config/env.ts` REFUSES to start with
# under NODE_ENV=production, so it cannot reach a deployment by being forgotten.
#
# Any real deployment generates its own and never commits it:
#
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Rotating it invalidates every token already issued, which is exactly what you
# want if one ever leaks.
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-deployment

# Access-token lifetime in seconds. 900 = 15 minutes: short enough that a leaked
# token expires on its own, and the window the refresh flow (E1.3) is sized for.
JWT_ACCESS_TTL_SECONDS=900

# How long a login lasts before the password is needed again (E1.3). 604800 = 7
# days, and it is both the `sessions.expires_at` horizon and the refresh
# cookie's Max-Age.
#
# There is deliberately no second signing secret here: the refresh cookie is an
# opaque random value, not a JWT, and only its SHA-256 is stored. Nothing about
# it is verifiable without the `sessions` row, which is what makes logout
# instant rather than eventual.
#
# E1.6 asked for a "refresh secret" alongside this TTL and did not add one, for
# the same reason: there is nothing to sign, so the variable would be a key no
# code reads. The endpoints that consume this value are POST /auth/refresh and
# POST /auth/logout; the horizon is absolute, so refreshing does not extend it.
REFRESH_TTL_SECONDS=604800

# Rate limit for /auth/login and /auth/register, per client IP, per route.
# Login costs ~250 ms of bcrypt and is the app's brute-force target; 10 attempts
# a minute is far above what a human typing a password needs.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Separate, far larger bucket for /auth/refresh, in the same window (E1.6).
# That endpoint is unauthenticated and does one indexed lookup per call, so it
# is bounded rather than left open — but it must not share the login bucket:
# every browser tab refreshes on load, so ten a minute would 429 a normal user
# behind one address and the frontend would read that as a logout. There is
# nothing to brute-force here either way; the cookie's secret is 32 CSPRNG
# bytes, so this limit is about load, not guessing.
REFRESH_RATE_LIMIT_MAX=100

# Who is in front of the API, which is what decides whose address the two limits
# above count. `1` means one proxy: take the address that proxy recorded in
# X-Forwarded-For rather than the socket address.
#
# It must be `1` for this stack, because the browser reaches /auth through the
# frontend origin — nginx in the base stack, the Vite dev server under the
# override — so every auth request arrives from the frontend container. On
# `false` the API would count that one address for everybody: AUTH_RATE_LIMIT_MAX
# would be ten login attempts per minute for the whole practice, and the eleventh
# from any one browser would lock everyone out.
#
# A hop count trusts the header on EVERY route into the API, including a direct
# one where the client wrote it themselves. That is why docker-compose.yml
# publishes no backend port: the proxy is the only way in, so the header can only
# have come from the proxy. If you expose the API directly, this must go back to
# `false` — and then the browser must stop reaching it through another origin.
#
# `true` is rejected outright: it takes the leftmost entry, which the client
# always controls, so every request would look like a new address.
TRUST_PROXY=1

# --- Mailpit ------------------------------------------------------------------
# Dev/test mail catcher: nothing it receives ever leaves the machine.
# SMTP is what the backend talks to; the UI is where you read the messages.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application ports --------------------------------------------------------
# Host ports for the two app services. The backend listens on BACKEND_PORT
# inside its container too; the frontend container serves on 80 (production
# build behind nginx) or 5173 (Vite dev server under docker-compose.override.yml).
#
# Only the dev override publishes BACKEND_PORT to the host (see TRUST_PROXY).
# Changing it away from 3000 also needs docker/frontend/nginx.conf, which names
# `backend:3000` literally — and since that proxy is the only way into the API in
# the base stack, a mismatch there takes the whole app down, not just one route.
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- Worker (added by 4.1) ----------------------------------------------------
# The pg-boss worker serves a /health endpoint on this port for the compose
# healthcheck. Container-internal only: no compose file publishes it, so it never
# collides with anything on the host.
#
# Blank or unset means 3001 — config/env.ts and the compose probe share that
# default, so the two cannot disagree about where /health is.
WORKER_HEALTH_PORT=3001

# Interface the /health server binds to. Defaults to 0.0.0.0, which a container
# needs, so compose does not pass it through. Only for running the worker on a
# host directly (`pnpm --filter @physiobook/backend dev:worker`), e.g. to keep the
# probe off the network with 127.0.0.1.
# WORKER_HEALTH_HOST=0.0.0.0

# --- Mail (added by 4.2) ------------------------------------------------------
# SMTP transport for notification email. Read by the WORKER only: mail is sent
# from pg-boss jobs, never inside a request, so the API holds no SMTP
# credentials. The worker refuses to start without MAIL_HOST, MAIL_PORT and
# MAIL_FROM — a missing transport must fail at boot, not drop every reminder.
#
# These values are for a worker run on the host against the compose Mailpit
# (`pnpm --filter @physiobook/backend dev:worker`): localhost on
# MAILPIT_SMTP_PORT. The worker container ignores MAIL_HOST/MAIL_PORT —
# docker-compose.yml points it at the `mailpit` service on the compose network,
# just as it does for DATABASE_URL.
#
# Production sets these to the provider's SMTP endpoint.
MAIL_HOST=localhost
MAIL_PORT=1025

# Implicit TLS from the first byte (port 465). `false` still upgrades with
# STARTTLS when the server offers it, which is what port 587 expects.
MAIL_SECURE=false

# SMTP credentials, set both or neither. Blank for Mailpit, which accepts
# anything. A real provider's password is a secret: it comes from the
# deployment environment, never from this file.
MAIL_USER=
MAIL_PASSWORD=

# Sender address on every notification. A bare address, validated at boot.
MAIL_FROM=no-reply@physiobook.local
