# PhysioBook — example environment
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is not.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# This file documents EVERY variable the app needs. It grows as tickets
# introduce variables:
#   0.2  docker compose  -> POSTGRES_*, DATABASE_URL, MAILPIT_*, service ports
#   E1   backend config  -> JWT_SECRET, JWT_REFRESH_SECRET
#   E6   notifications   -> SMTP_* / mail provider credentials
#
# Rule (CLAUDE.md §5.8): no secrets in code. Every variable is validated at boot
# by `backend/src/config/env.ts` (Zod) and this file is updated in the same PR
# that adds it.
#
# The values below are local-development defaults and are safe to commit — they
# only ever reach a throwaway container. Production values come from the
# deployment environment, never from a file in the repo.

# Runtime mode: development | test | production
NODE_ENV=development

# --- Postgres -----------------------------------------------------------------
# Consumed by the `postgres` service (POSTGRES_* are the official image's own
# variables) and used by docker-compose.yml to build the backend's in-network
# connection string.
POSTGRES_USER=physiobook
POSTGRES_PASSWORD=physiobook
POSTGRES_DB=physiobook

# Host port the database is published on. Change it if 5432 is already taken by
# a local Postgres install; the in-container port is always 5432.
POSTGRES_PORT=5432

# Host-facing connection string: for tools you run on the host (drizzle-kit,
# psql, one-off scripts). It points at localhost:POSTGRES_PORT.
#
# The backend container does NOT use this — docker-compose.yml gives it a URL
# pointing at the `postgres` service on the compose network instead. Keep the
# credentials here in sync with POSTGRES_* above.
DATABASE_URL=postgres://physiobook:physiobook@localhost:5432/physiobook

# Password hash for the default admin (admin@physiobook.local) that the users
# data migration creates. Read ONLY on the first migrate of a database that has
# no admin yet — setting it later changes nothing.
#
# Left blank here on purpose. Blank means the migration falls back to a hash
# whose password is committed in db/migrations/0001_users_updated_at_and_admin.sql
# and is therefore public, which is fine for a throwaway local database and
# nowhere else. `pnpm db:migrate` warns every time it takes that path.
#
# Any real deployment sets this to a bcrypt/argon2 hash it generated itself.
ADMIN_PASSWORD_HASH=

# --- Mailpit ------------------------------------------------------------------
# Dev/test mail catcher: nothing it receives ever leaves the machine.
# SMTP is what the backend talks to; the UI is where you read the messages.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application ports --------------------------------------------------------
# Host ports for the two app services. The backend listens on BACKEND_PORT
# inside its container too; the frontend container serves on 80 (production
# build behind nginx) or 5173 (Vite dev server under docker-compose.override.yml).
BACKEND_PORT=3000
FRONTEND_PORT=5173
