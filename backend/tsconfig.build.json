{
  // Emit config used only by the Docker production build. The default
  // tsconfig.json is noEmit (it exists for `typecheck` and covers tests too);
  // this one compiles src/ to dist/ so the runtime image can run plain JS
  // without a TypeScript loader.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
    // No sourceMap: the runtime image ships dist/ without src/, so the maps
    // would point at files that are not there. Add them back together with
    // the sources if stack traces ever need to be readable in a deployed
    // container.
  },
  "include": ["src"]
}
