{
  "name": "@physiobook/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API server + pg-boss worker.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
